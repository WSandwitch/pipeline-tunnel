# Legacy release image (smaller size, ~10% slower)
FROM alpine:3.19 AS builder
RUN apk add --no-cache \
    build-base \
    cmake \
    openssl-dev \
    linux-headers \
    musl-dev \
    curl \
    ca-certificates

COPY zig-*.tar.xz /tmp/
RUN set -eux; \
    ARCH=$(uname -m); \
    case "$ARCH" in \
      x86_64)  ZIG_ARCH="x86_64" ;; \
      aarch64) ZIG_ARCH="aarch64" ;; \
      *)       echo "unsupported arch: $ARCH"; exit 1 ;; \
    esac; \
    tar xJf "/tmp/zig-${ZIG_ARCH}-linux-0.16.0.tar.xz" -C /usr/local; \
    ln -sf "/usr/local/zig-${ZIG_ARCH}-linux-0.16.0/zig" /usr/local/bin/zig; \
    rm "/tmp/zig-${ZIG_ARCH}-linux-0.16.0.tar.xz"

COPY . /src
WORKDIR /src
RUN cmake -B /build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build -j"$(nproc)" \
    && cmake --build /build --target pack

FROM alpine:3.19
RUN apk add --no-cache \
    libssl3 \
    libcrypto3 \
    libstdc++
COPY --from=builder /src/out/ /app/
COPY release/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
WORKDIR /app
ENTRYPOINT ["/app/entrypoint.sh"]
