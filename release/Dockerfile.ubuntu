# Primary release image (matches host glibc, best perf)
FROM ubuntu:22.04 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libssl-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY zig-*.tar.xz /tmp/
RUN set -eux; \
    ARCH=$(uname -m); \
    case "$ARCH" in \
      x86_64)  ZIG_ARCH="x86_64" ;; \
      aarch64) ZIG_ARCH="aarch64" ;; \
      *)       echo "unsupported arch: $ARCH"; exit 1 ;; \
    esac; \
    tar xJf "/tmp/zig-${ZIG_ARCH}-linux-0.16.0.tar.xz" -C /usr/local; \
    ln -sf "/usr/local/zig-${ZIG_ARCH}-linux-0.16.0/zig" /usr/local/bin/zig; \
    rm "/tmp/zig-${ZIG_ARCH}-linux-0.16.0.tar.xz"

COPY nim-*.tar.xz /tmp/
RUN set -eux; \
    ARCH=$(uname -m); \
    case "$ARCH" in \
      x86_64)  NIM_ARCH="x64" ;; \
      aarch64) NIM_ARCH="arm64" ;; \
      *)       echo "unsupported arch: $ARCH"; exit 1 ;; \
    esac; \
    tar xJf "/tmp/nim-2.2.8-linux_${NIM_ARCH}.tar.xz" -C /usr/local; \
    ln -sf "/usr/local/nim-2.2.2/bin/nim" /usr/local/bin/nim; \
    rm "/tmp/nim-2.2.8-linux_${NIM_ARCH}.tar.xz"

COPY rustup-* /tmp/
RUN set -eux; \
    ARCH=$(uname -m); \
    case "$ARCH" in \
      x86_64)  RUST_ARCH="x86_64" ;; \
      aarch64) RUST_ARCH="aarch64" ;; \
      *)       echo "unsupported arch: $ARCH"; exit 1 ;; \
    esac; \
    chmod +x "/tmp/rustup-init-${RUST_ARCH}-unknown-linux-gnu"; \
    "/tmp/rustup-init-${RUST_ARCH}-unknown-linux-gnu" -y --default-toolchain stable --profile minimal; \
    . /root/.cargo/env; \
    rustc --version; \
    cargo --version; \
    ln -sf /root/.cargo/bin/cargo /usr/local/bin/; \
    ln -sf /root/.cargo/bin/rustc /usr/local/bin/; \
    rm "/tmp/rustup-init-${RUST_ARCH}-unknown-linux-gnu"

COPY . /src
WORKDIR /src
RUN cmake -B /build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build -j"$(nproc)" \
    && cmake --build /build --target pack

FROM ubuntu:22.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libstdc++6 \
    ca-certificates \
    libzstd1 \
    libsnappy1v5 \
    zlib1g \
    liblz4-1 \
    libbrotli1 \
    liblzo2-2 \
    liblzma5 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/out/ /app/
COPY release/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
WORKDIR /app
ENTRYPOINT ["/app/entrypoint.sh"]
