# Legacy dev image (musl, ~10% slower than ubuntu)
FROM alpine:3.19
RUN apk add --no-cache \
    build-base \
    cmake \
    openssl-dev \
    linux-headers \
    musl-dev \
    procps-ng \
    coreutils \
    ruby \
    iperf3 \
    iproute2 \
    curl \
    python3 \
    gdb \
    zstd-libs \
    snappy \
    zlib

COPY zig-*.tar.xz /tmp/
RUN set -eux; \
    ARCH=$(uname -m); \
    case "$ARCH" in \
      x86_64)  ZIG_ARCH="x86_64" ;; \
      aarch64) ZIG_ARCH="aarch64" ;; \
      *)       echo "unsupported arch: $ARCH"; exit 1 ;; \
    esac; \
    tar xJf "/tmp/zig-${ZIG_ARCH}-linux-0.16.0.tar.xz" -C /usr/local; \
    ln -sf "/usr/local/zig-${ZIG_ARCH}-linux-0.16.0/zig" /usr/local/bin/zig; \
    rm "/tmp/zig-${ZIG_ARCH}-linux-0.16.0.tar.xz"

COPY nim-*.tar.xz /tmp/
RUN set -eux; \
    tar xJf "/tmp/nim-2.2.2-linux_x64.tar.xz" -C /usr/local; \
    ln -sf "/usr/local/nim-2.2.2/bin/nim" /usr/local/bin/nim; \
    rm "/tmp/nim-2.2.2-linux_x64.tar.xz"

WORKDIR /app
